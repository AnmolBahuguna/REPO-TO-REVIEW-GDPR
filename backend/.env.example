# Optional. Public repository scans work without a token; this increases GitHub API limits.
GITHUB_TOKEN=

# Optional. Only used when the UI's AI explanations option is enabled.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FREE_MODEL=minimax/minimax-m3.1-flash:free

# Optional. Enables OpenRouter for legal RAG answers and general chat.
# With this false, legal answers use local excerpts and general chat is disabled.
LEGAL_ASSISTANT_USE_OPENROUTER=false
